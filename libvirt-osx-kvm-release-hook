#!/usr/bin/env bash
set -Eeuo pipefail

# libvirt calls this qemu.d script as: qemu osx-kvm release end.
# Libvirt has completed the managed-device release phase before this hook
# runs. The X99 USB controller has no VFIO reset path, so this host is
# configured to power off instead of attempting to restore a graphical
# session after the macOS VM stops.

if [[ "${1:-}" != "osx-kvm" || "${2:-}" != "release" || "${3:-}" != "end" ]]; then
  exit 0
fi

log() {
  /usr/bin/logger -t osx-kvm-release -- "$*"
  echo "osx-kvm: $*" >&2
}

log 'macOS VM released; requesting clean host poweroff (X99 USB reset workaround)'

# systemctl queues the shutdown job and returns, allowing libvirt's hook to
# finish before systemd stops libvirtd and powers the machine down.
/usr/bin/systemctl poweroff --no-wall || log 'failed to queue host poweroff'
