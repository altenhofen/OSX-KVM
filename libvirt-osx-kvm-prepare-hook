#!/usr/bin/env bash
set -Eeuo pipefail

# Automatic single-GPU handoff for the osx-kvm domain.
# libvirt calls this qemu.d script as: qemu osx-kvm prepare begin
# This intentionally affects only the VM named osx-kvm.

if [[ "${1:-}" != "osx-kvm" || "${2:-}" != "prepare" || "${3:-}" != "begin" ]]; then
  exit 0
fi

echo "osx-kvm: stopping SDDM before RX 5600 handoff" >&2
/usr/bin/systemctl stop sddm.service

# SDDM stopping the display manager normally ends Hyprland. Wait for all
# known Omarchy graphical-session processes before touching the PCI devices.
for _ in {1..40}; do
  graphical_process=0
  for proc in Hyprland sddm sddm-helper start-hyprland; do
    if /usr/bin/pgrep -x "$proc" >/dev/null 2>&1; then
      graphical_process=1
      break
    fi
  done
  [[ $graphical_process -eq 0 ]] && break
  /usr/bin/sleep 0.25
done

for proc in Hyprland sddm sddm-helper start-hyprland; do
  if /usr/bin/pgrep -x "$proc" >/dev/null 2>&1; then
    echo "osx-kvm: $proc did not exit; aborting GPU handoff" >&2
    /usr/bin/systemctl start sddm.service || true
    exit 1
  fi
done

/usr/bin/modprobe vfio-pci
echo "osx-kvm: SDDM stopped; libvirt will detach the RX 5600 and USB controller" >&2
